     *   tournament_name  — name of the tournament
     *   prize            — prize description (e.g. "₦5,000" or "500 tickets")
     *   preheader        — "You won <prize> in <tournament_name> — congrats!"
     */
  },

  // ── support app ────────────────────────────────────────────────────────────
  disputeOpened: {
    app:  'support' as MailAppName,
    slug: 'gamebyte-dispute-opened',
    /**
     * Payload:
     *   user_name       — display name
