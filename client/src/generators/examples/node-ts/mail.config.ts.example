/**
 * mail.config.ts
 *
 * Defines every Mail Service "app" (each app = one sender email + one API key)
 * and the templates that belong to each app.
 *
 * To add a new sender:
 *   1. Add an entry to MAIL_APPS
 *   2. Add MAIL_KEY_<NAME> to .env
 *   3. Add templates to MAIL_TEMPLATES pointing to that app
 *
 * To add a new template:
 *   1. Add an entry to MAIL_TEMPLATES (pick the app, set the slug)
 *   2. Add a typed helper in MailService
 */

// ─── Apps ─────────────────────────────────────────────────────────────────────

export const MAIL_APPS = {
  /**
   * notify@yourdomain.com
   * Used for: automated transactional emails (payments, withdrawals, tournament events, welcome)
   */
  notify: {
    fromEmail: 'notify@yourdomain.com',
    keyEnv:    'MAIL_KEY_NOTIFY',
  },

  /**
   * support@yourdomain.com
   * Used for: disputes, KYC, ban notifications — anything a user might reply to
   */
  support: {
    fromEmail: 'support@yourdomain.com',
    keyEnv:    'MAIL_KEY_SUPPORT',
  },
} as const;

export type MailAppName = keyof typeof MAIL_APPS;

// ─── Templates ────────────────────────────────────────────────────────────────
// Each template declares:
//   - which app sends it (determines the "from" address and API key)
//   - the slug configured in the Mail Service dashboard
//   - the payload fields that must be passed in `data`

export const MAIL_TEMPLATES = {

  // ── notify app ─────────────────────────────────────────────────────────────
  welcome: {
    app:  'notify' as MailAppName,
    slug: 'gamebyte-welcome-notification',
    /**
     * Payload:
     *   user_name  — display name shown in greeting
     *   username   — account username
     *   email      — user's email address
     *   preheader  — "Welcome to GameByte — your arena for competitive gaming starts now."
     */
  },

  tournamentWon: {
    app:  'notify' as MailAppName,
    slug: 'gamebyte-tournament-winner',
    /**
     * Payload:
